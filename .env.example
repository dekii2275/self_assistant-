# -------------------------------------------------------------
# Configuration Ports & Credentials
# To avoid port collisions, custom unique ports are mapped:
# -------------------------------------------------------------
FRONTEND_PORT=5274
BACKEND_PORT=8974
POSTGRES_PORT=5974

POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=assistant_db

# Email reminders (optional). Use a provider-specific SMTP app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
REMINDER_TIMEZONE=Asia/Bangkok
