# Database URL từ Neon.tech, Supabase hoặc Render Postgres
# Ví dụ: DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://app_user:secret_app_password@localhost:5974/assistant_db

# CORS Allowed Origins (phân tách bởi dấu phẩy)
BACKEND_CORS_ORIGINS=http://localhost:5274,http://localhost:5173,https://*.vercel.app

# Email reminders (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
REMINDER_TIMEZONE=Asia/Bangkok
